# =========================================================
# UK-GSMP Backend Environment Variables
# =========================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =========================================================

# Application settings
PORT=10000
NODE_ENV=development

# ---------------------------------------------------------
# Supabase Configurations
# ---------------------------------------------------------
# Your Supabase Project API URL (base URL, no /rest/v1/ suffix)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key (Anon Public key for auth/database queries)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Your Supabase Service Role Key (Admin secret key — used for server-side DB queries)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Your Supabase JWT Secret (Used for symmetric HS256 token verification)
# Locate this under Project Settings -> API -> JWT Settings in the Supabase Dashboard
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Your Supabase Project Reference (e.g. the subdomain part of your supabase URL)
# Used for RS256 JWKS public key checks
SUPABASE_PROJECT_REF=your-project-ref

# ---------------------------------------------------------
# Integrations (Optional)
# ---------------------------------------------------------
# Base URL for frontend application (used in CORS/redirect links)
BASE_URL=http://localhost:3000

# Google Calendar service account JSON string for Google Meet integration
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account",...}'

# OpenAI API key (for AI-powered features)
# OPENAI_API_KEY=sk-your-openai-key
